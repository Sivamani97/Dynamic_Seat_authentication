# -----------------------------------------------------------------------------
# SmartSeat: Dynamic Seat Authentication & Emergency Response System
# Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# -----------------------------------------------------------------------------

# Supabase Project Configuration (Obtain from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# CRITICAL: SUPABASE_SERVICE_ROLE_KEY is used exclusively in server Route Handlers. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cryptographic Token Signing Secret (32+ character high-entropy hex or random string)
# Used for HMAC-SHA256 signature verification of dynamic 30s ticket tokens.
TOKEN_SIGNING_SECRET=4f8b9e2c6a1d3f5e7a9b0c2d4e6f8a1b3c5e7d9f1a3b5c7d9e1f3a5b7c9d1e3f

# Cron Job Secret
# Secures /api/cron/evaluate against unauthorized external invocations. Sent as Bearer token by Vercel Cron.
CRON_SECRET=super-secret-cron-token-value-change-me

# Public Application Base URL (Used for ticket link redirection, QR codes, and simulated email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# (Optional) Upstash Redis Configuration for Distributed Token Rate Limiting
# If omitted or unconfigured, SmartSeat automatically falls back to atomic PostgreSQL-based rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# (Optional) Resend API Key for real transactional email delivery
# If omitted, SmartSeat persists generated emails into the in-app email_outbox table.
RESEND_API_KEY=
